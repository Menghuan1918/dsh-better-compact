{
  "name": "dsh-better-compact",
  "version": "0.3.1",
  "description": "Independent DSH compaction plugin: native, goal-aware, and file-handoff checkpoints with a read-only inspect API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-better-compact.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/runtime-smoke.mjs"
  },
  "files": [
    "src",
    "presets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "third-party"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/better-compact.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "homepage": "https://github.com/omdsh-dev/dsh-better-compact#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-better-compact/issues"
  }
}
